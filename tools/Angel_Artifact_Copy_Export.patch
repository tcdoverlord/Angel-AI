+    def _insert_artifact_block(self, language: str, content: str) -> None:
+        """
+        Render generated files/code as artifacts instead of plain text.
+        Stores the latest artifact for future copy/save/export actions.
+        """
+
+        self.last_artifact = {
+            "language": language,
+            "content": content,
+        }
+
+        self.chat.insert(
+            "end",
+            f"\n[{language.upper()} ARTIFACT]\n",
+            "source_header"
+        )
+
+        self.chat.insert(
+            "end",
+            content + "\n",
+            "code"
+        )
+
+        self.chat.insert(
+            "end",
+            "\nArtifact stored. Copy/Save/Export actions available.\n",
+            "angel_text"
+        )
+
+    def copy_artifact(self) -> None:
+        """
+        Copy the most recent generated artifact.
+        """
+
+        if not hasattr(self, "last_artifact"):
+            self._set_thinking("No artifact available")
+            return
+
+        self.root.clipboard_clear()
+        self.root.clipboard_append(
+            self.last_artifact["content"]
+        )
+
+        self._set_thinking("Artifact copied")